{
  "name": "folio",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run icons:build && tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/build-sw.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "node --experimental-strip-types --test tests/storage.test.ts tests/artwork-search.test.ts tests/artwork-entry.test.ts tests/address-parser.test.ts tests/countries.test.ts tests/information-geography.test.ts tests/globe-projection.test.ts",
    "dev:api": "wrangler dev --port 8787",
    "preview:cloud": "wrangler dev --ip 0.0.0.0 --port 5173",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply folio --local",
    "db:remote": "wrangler d1 migrations apply folio --remote",
    "cf:types": "wrangler types",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:frontend": "npm run icons:build && node scripts/build-desktop-icons.mjs && tsc -b && vite build --mode desktop --outDir dist-desktop",
    "desktop:build": "node scripts/prepare-installer.mjs && node scripts/desktop.mjs build",
    "desktop:test": "node scripts/desktop.mjs test",
    "tauri": "tauri",
    "site:dev": "vite site/public --host 127.0.0.1 --port 5175",
    "site:deploy": "wrangler deploy --config site/wrangler.jsonc",
    "test:account": "node --test tests/provision-account.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "7.6.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.148.0"
  },
  "license": "MIT",
  "author": "RyanLin",
  "description": "Your cards, phone numbers and addresses. Self-hosted web or offline Windows desktop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/GboyCode/Folio.git"
  },
  "homepage": "https://folio.toagi.cc",
  "engines": {
    "node": ">=22.18.0"
  }
}
